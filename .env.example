# KampusDey environment. Copy to .env and fill in. Never commit .env.
# Settings module: config.settings.dev (local), config.settings.prod (production).
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Core -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Public base URL, used in emails, sitemaps, OG tags and the importer User-Agent.
SITE_URL=http://localhost:8000
# Admin lives at /<ADMIN_URL>; change it in production.
ADMIN_URL=admin/
# Staff must set up TOTP before using the admin. Set False only for local work.
STAFF_MFA_REQUIRED=True

# Fernet key(s) for encrypted admin secrets. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate: put the NEW key first, comma, old key; run `manage.py rotate_field_keys`; then drop the old key.
FIELD_ENCRYPTION_KEY=

# --- Database / cache / broker ---------------------------------------------
# SQLite by default. Production: postgres://user:pass@host:5432/kampusdey
DATABASE_URL=sqlite:///db.sqlite3
# Optional. Without Redis: DB cache, Celery runs tasks inline, use `manage.py run_periodic --loop`.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_TASK_ALWAYS_EAGER=

# --- Email (SMTP) -----------------------------------------------------------
# Dev default prints emails to the console. For Mailpit use smtp on localhost:1025.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=KampusDey <no-reply@kampusdey.local>
SERVER_EMAIL=KampusDey <no-reply@kampusdey.local>

# --- Optional Google login --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage ----------------------------------------------------------------
# local | s3 (S3-compatible, e.g. Cloudflare R2)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
# Separate private bucket for verification documents and claim proofs.
PRIVATE_STORAGE_BUCKET=

# --- Monitoring -------------------------------------------------------------
SENTRY_DSN=
DEBUG_TOOLBAR=False

# --- Web push (generate with `pip install py-vapid && vapid --gen`) ---------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# --- GeoIP / maps -----------------------------------------------------------
# Folder holding GeoLite2-City.mmdb (downloaded by `manage.py update_geolite2`).
GEOIP_PATH=geoip
MAP_USER_AGENT=KampusDey/1.0 (+http://localhost:8000/contact)

# --- Production security (prod settings) ------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
CONN_MAX_AGE=60
AXES_PROXY_COUNT=0
CSP_EXTRA_SCRIPT_HOSTS=
